# LEDGERHUNT-CRYPTO secrets and settings.
# Copy to .env (git-ignored) at the repo root and fill in values there. Never commit .env.
# Real environment variables take precedence over .env. Every value of a *_KEY, *_TOKEN,
# *_SECRET, *_JWT or *_RPC_URL variable is treated as secret and redacted from logs/results.

# Anthropic Claude API key (official SDK, always against https://api.anthropic.com).
# Needed only for `--llm` runs (llm_models). ANTHROPIC_BASE_URL is ignored by project code.
ANTHROPIC_API_KEY=

# TronGrid API key (sent only as the TRON-PRO-API-KEY header). Without it: keyless, 1 rps.
TRONGRID_API_KEY=

# Paid TRON node provider (java-tron HTTP API base URL, e.g. Chainstack/GetBlock/Nodit).
# The whole URL is secret because providers embed the key in it. `/wallet/...` is appended.
TRON_RPC_URL=
# Optional second paid TRON provider for cross-checks.
TRON_RPC_URL_2=

# TronScan API key (TronScan is outside the critical path; only if the owners allow its use).
TRONSCAN_API_KEY=

# Ethereum JSON-RPC URL of a paid provider (may embed a key; whole value is secret).
# Without it the keyless https://ethereum-rpc.publicnode.com is used.
ETH_RPC_URL=

# Etherscan API key (optional; Etherscan requires it as a query parameter, which is never logged).
ETHERSCAN_API_KEY=

# Blockscout PRO API key (optional; keyless works at about 3 rps).
BLOCKSCOUT_API_KEY=

# NEAR Intents 1Click JWT (optional; the status endpoint works without it).
NEAR_INTENTS_JWT=

# --- Non-secret settings (optional) ---
# record | replay | cache | live  (the CLI sets this; --replay forces replay)
# LEDGERHUNT_HTTP_MODE=record
# Store for raw HTTP responses (default data/http-store)
# LEDGERHUNT_HTTP_STORE=data/http-store
# LEDGERHUNT_LOG_LEVEL=INFO
