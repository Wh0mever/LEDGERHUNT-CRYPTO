     "enum": [
      "pre_theft_inflow",
      "pre_theft_history",
      "zero_value_poisoning",
      "lookalike_dust",
      "failed_transaction",
      "approval_not_transfer",
      "foreign_inflow",
      "foreign_outflow",
      "exchange_internal",
      "unrelated"
     ],
     "title": "Reason",
     "type": "string"
    }
   },
   "required": [
    "txid",
    "reason"
